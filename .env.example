# O Node recebe estas variáveis pelo ambiente; nenhum segredo de nuvem é necessário.
PORT=4100
HOST=127.0.0.1
# DATA_DIR=C:/caminho/privado/forma-data
# APP_ORIGIN=http://127.0.0.1:4100
# SECURE_COOKIE=true somente com HTTPS configurado
# Supabase opcional, somente backend. Conta/convites exigem migrações forma;
# não migra dados locais, projetos, Storage ou desktop automaticamente.
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# FORMA_UPLOAD_VERIFIER: segredo próprio da inspeção de uploads, só no servidor.
# Gerar com node scripts/prepare-upload-verifier.mjs e configurar a mesma chave
# em forma.upload_verifiers por operação administrativa. Nunca usar VITE_*.
# FORMA_DESKTOP_URL: somente depuração com servidor do build dist-desktop.
# Não apontar o desktop ao npm run dev do site, pois esse build inclui a landing.
# Billing: somente backend. Nenhum valor real deve ir para o chat ou bundle.
# FORMA_BILLING_SECRET: gerar com node scripts/prepare-billing-secret.mjs;
# configurar a mesma chave em forma_billing.server_keys por operação privada.
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_COLLECTOR_ID=
# MERCADOPAGO_WEBHOOK_SECRET=
# MERCADOPAGO_MODE=test
# FORMA_BILLING_BACK_URL=https://seu-dominio/#central
# FORMA_BILLING_TERMS_VERSION=beta-1
# FORMA_BILLING_SALES_ENABLED=false
# O gate no código e o gate do banco permanecem fechados até o aceite de entrega.
# Mídia: SDK/segredos apenas backend. .env.media.local é ignorado e serve ao piloto.
# LIVEKIT_URL=wss://seu-projeto.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# No piloto local, npm run dev inicia o binário oficial em .tools/livekit se existir.
# WS é aceito somente para localhost/127.0.0.1; produção requer WSS/segredo forte.
